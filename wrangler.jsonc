{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "only-us",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything else is served straight from static assets.
    "run_worker_first": ["/supabase/*", "/api/*"],
  },
  "vars": {
    "SUPABASE_URL": "https://laywfuhtlcbhencsmrnb.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_BdGrvclgai3kjPxKESkMiQ_jW-GgXLI",
  },
  // Secrets, set in the Cloudflare dashboard (never committed):
  //   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY — see docs/SETUP.md
}
